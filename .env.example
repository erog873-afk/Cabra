# Токен вашего Telegram-бота (из @BotFather). Нужен для проверки подлинности initData.
BOT_TOKEN=123456789:AA...ваш_токен

# Порт, на котором поднимется сервер
PORT=3000

# true = ОТКЛЮЧИТЬ проверку initData (только для локального тестирования без реального Telegram!)
# В проде обязательно оставить false.
DEV_MODE=true
